{
  "$defs": {
    "EventMessage": {
      "enum": [
        "inventory_started",
        "awaiting_confirmation",
        "staging_media",
        "analyzing_media",
        "planning_edit",
        "rendering_output",
        "verifying_output",
        "importing_output",
        "cleaning_up",
        "run_succeeded",
        "run_failed",
        "run_cancelled",
        "source_excluded",
        "no_confident_swings"
      ],
      "title": "EventMessage",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "status",
        "progress",
        "warning",
        "complete",
        "error"
      ],
      "title": "EventType",
      "type": "string"
    },
    "NoticeCode": {
      "enum": [
        "source_failure",
        "no_confident_swings",
        "permission_denied",
        "cost_estimate_unavailable",
        "malformed_analysis",
        "output_verification_failed",
        "import_failed",
        "cancelled"
      ],
      "title": "NoticeCode",
      "type": "string"
    },
    "RunStage": {
      "enum": [
        "created",
        "inventory",
        "awaiting_confirmation",
        "staging",
        "analyzing",
        "planning",
        "rendering",
        "verifying",
        "importing",
        "cleanup",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bounded JSONL event safe for Pi conversation display.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event": {
      "$ref": "#/$defs/EventType"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/RunStage"
    },
    "message": {
      "$ref": "#/$defs/EventMessage"
    },
    "completed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed"
    },
    "total": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    },
    "notice_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoticeCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "event",
    "run_id",
    "stage",
    "message",
    "occurred_at"
  ],
  "title": "RunEvent",
  "type": "object"
}
