{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swingcut.local/schemas/swing-analysis-v1.schema.json",
  "title": "Swingcut swing analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "contains_apparent_ball_strike", "confidence"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "contains_apparent_ball_strike": { "type": "boolean" },
    "rejection_reason": {
      "type": ["string", "null"],
      "enum": [
        "no_swing",
        "practice_only",
        "false_start",
        "aborted",
        "incomplete",
        "no_apparent_strike",
        "occluded",
        "uncertain",
        null
      ]
    },
    "takeaway_s": { "type": ["number", "null"], "minimum": 0 },
    "impact_s": { "type": ["number", "null"], "minimum": 0 },
    "finish_s": { "type": ["number", "null"], "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string" }
  }
}
